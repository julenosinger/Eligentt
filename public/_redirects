# Elligente — Cloudflare Pages redirects
# Public Elligentt Pay checkout (/pay/:token) is served by the Pages Function
# functions/pay/[token].js (a static .html rewrite would trigger Pages' auto
# HTML redirect and strip the dynamic token).
# API routes — let Pages Functions handle them, do NOT rewrite to index.html
/api/*  /api/:splat  404
# Single-page app: all routes serve index.html
/*    /index.html   200
