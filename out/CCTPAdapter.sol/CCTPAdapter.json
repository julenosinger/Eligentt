Testnet):        - TokenMessengerV2: 0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA        - USDC:              0x3600000000000000000000000000000000000000\",\"kind\":\"dev\",\"methods\":{\"configureIntent(bytes32,uint32,bytes32,bytes32)\":{\"details\":\"Must be called before executeBridgeIntent on the executor.         msg.sender is recorded as the funder \\u2014 they must have approved         the burnToken to this adapter before executeBridgeIntent.\"},\"constructor\":{\"params\":{\"_tokenMessenger\":\"CCTP TokenMessengerV2 address on the deployment chain\"}},\"sendMessage(uint256,bytes)\":{\"details\":\"Called exclusively by the MultiSendExecutorV3.0.3 when executing an intent.      Pulls tokens from the funder (configureIntent caller), approves TokenMessenger,      and calls depositForBurn.\",\"params\":{\"destinationChain\":\"The destination chain identifier as stored in the executor batch.\",\"payload\":\"Encoded data: abi.encode(intentId, token).\"},\"returns\":{\"_0\":\"messageId A transport-specific identifier for the bridged message.\"}}},\"title\":\"CCTPAdapter\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"clearIntent(bytes32)\":{\"notice\":\"Remove a pre-configured intent (gas refund).\"},\"configureIntent(bytes32,uint32,bytes32,bytes32)\":{\"notice\":\"Pre-configure CCTP-specific routing data for an intent.\"},\"sendMessage(uint256,bytes)\":{\"notice\":\"Deliver a cross-chain message via the adapter's transport.\"}},\"notice\":\"Circle CCTP v2 bridge adapter compatible with MultiSendExecutorV3.0.3.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/CCTPAdapter.sol\":\"CCTPAdapter\"},\"evmVersion\":\"shanghai\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"contracts/CCTPAdapter.sol\":{\"keccak256\":\"0xa6ac6a4706ac8e20b9293c0d30d4f5c1041f22d55481277060faa4a5778ada06\",\"license\":\"MIT\",\"urls\":[\"b