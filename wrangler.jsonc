{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elligente",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    // AUTH_KV — users, sessions, verification codes, wallets
    {
      "binding": "AUTH_KV",
      "id": "beae285652be47c993a4113359f22898"
    },
    // PAYMENT_LINKS — payment links
    {
      "binding": "PAYMENT_LINKS",
      "id": "a7a400f24ad441d29c3ab9e36f62069f"
    },
    // RATE_LIMIT_KV — rate limiting and replay protection
    {
      "binding": "RATE_LIMIT_KV",
      "id": "fb9584b52abe49618e4835836c8ec453"
    }
    // GATEWAY_OPS_KV — Circle Gateway operation state (non-production fallback only; DO is primary in prod).
    // To activate:
    //   1. CF Dashboard -> KV -> Create namespace -> name "GATEWAY_OPS_KV"
    //   2. Copy the namespace ID below (replace placeholder), uncomment, re-deploy.
    //   NOTE: KV is NOT atomic. Used only as non-production fallback. In production,
    //         GATEWAY_OP_LOCK (Durable Object, see below) is required; KV is disabled.
    // ,{
    //   "binding": "GATEWAY_OPS_KV",
    //   "id": "<your-gateway-ops-kv-namespace-id>"
    // }
  ],

  // ── Durable Object bindings ───────────────────────────────────────────────
  //
  // CF Pages cannot declare DO bindings inline for DOs hosted in a separate Worker.
  // The bindings below MUST be configured in CF Dashboard (not in this file).
  //
  // GATEWAY_OP_LOCK — atomic per-salt idempotence lock for Circle Gateway operations.
  // Activation steps:
  //   1. Create a separate CF Worker. Its wrangler.toml needs:
  //        [[durable_objects.bindings]]
  //        name = "GATEWAY_OP_LOCK"
  //        class_name = "GatewayOpLock"
  //        [[migrations]]
  //        tag = "v1"
  //        new_classes = ["GatewayOpLock"]
  //      Source file: functions/api/gateway/gateway-op-lock.do.js (export GatewayOpLock).
  //      Deploy: `wrangler deploy` from the Worker directory.
  //   2. CF Dashboard -> Pages -> elligentt -> Settings -> Functions
  //      -> Durable Object bindings -> Add:
  //        Variable name: GATEWAY_OP_LOCK
  //        Namespace: (the namespace created in step 1)
  //   3. CF Dashboard -> Pages -> elligentt -> Settings -> Environment variables
  //      -> Production -> Add:
  //        DO_INTERNAL_SECRET  = <openssl rand -hex 32>   (random 32-byte secret)
  //        GATEWAY_RPC_URLS    = {"42161":"https://...","5042":"https://...","8453":"https://...","1":"https://...","10":"https://...","137":"https://..."}
  //        GATEWAY_ENV         = production
  //   4. Re-deploy the Pages project.
  //
  // PAYMENT_LOCK — atomic per-(chainId+txHash) idempotence lock for payment links.
  //   Same activation process, using PaymentLock class from functions/api/payment-lock.do.js.
  //   Until activated, payment/[token].js falls back to KV-sentinel strategy.

  "vars": {
    "AUTH_MODE": "strict",
    "RATE_LIMIT_MODE": "enforce",
    "CIRCUIT_BREAKER": "on",
    "OBSERVABILITY": "on",
    "AUDIT": "on",
    "CORE_ALLOWED_ORIGINS": "https://execdaat.xyz,https://elligentt.xyz,https://elligente.pages.dev,https://elligentttest.pages.dev"
  }
}
