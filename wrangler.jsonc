{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elligente",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    // AUTH_KV — users, sessions, verification codes, wallets
    {
      "binding": "AUTH_KV",
      "id": "beae285652be47c993a4113359f22898"
    },
    // PAYMENT_LINKS — payment links
    {
      "binding": "PAYMENT_LINKS",
      "id": "a7a400f24ad441d29c3ab9e36f62069f"
    },
    // RATE_LIMIT_KV — rate limiting and replay protection
    {
      "binding": "RATE_LIMIT_KV",
      "id": "fb9584b52abe49618e4835836c8ec453"
    }
    // GATEWAY_OPS_KV — Circle Gateway operation state (non-production fallback only; DO is primary in prod).
    // To activate:
    //   1. CF Dashboard -> KV -> Create namespace -> name "GATEWAY_OPS_KV"
    //   2. Copy the namespace ID below (replace placeholder), uncomment, re-deploy.
    //   NOTE: KV is NOT atomic. Used only as non-production fallback. In production,
    //         GATEWAY_OP_LOCK (Durable Object, see below) is required; KV is disabled.
    // ,{
    //   "binding": "GATEWAY_OPS_KV",
    //   "id": "<your-gateway-ops-kv-namespace-id>"
    // }
  ],

  // ── Durable Object bindings ───────────────────────────────────────────────
  // GATEWAY_OP_LOCK — atomic per-salt idempotence lock for Circle Gateway ops.
  // Hosted in the standalone Worker `elligentt-gateway-op-lock` (workers/gateway-op-lock/),
  // which exports GatewayOpLock (SQLite-backed DO, migration v1). The Pages Functions
  // bind to its namespace via `script_name`.
  "durable_objects": {
    "bindings": [
      {
        "name": "GATEWAY_OP_LOCK",
        "class_name": "GatewayOpLock",
        "script_name": "elligentt-gateway-op-lock"
      }
    ]
  },

  // ── Durable Object bindings ───────────────────────────────────────────────
  //
  // CF Pages cannot declare DO bindings inline for DOs hosted in a separate Worker.
  // The bindings below MUST be configured in CF Dashboard (not in this file).
  //
  // GATEWAY_OP_LOCK — atomic per-salt idempotence lock for Circle Gateway operations.
  // Activation steps:
  //   1. Create a separate CF Worker. Its wrangler.toml needs:
  //        [[durable_objects.bindings]]
  //        name = "GATEWAY_OP_LOCK"
  //        class_name = "GatewayOpLock"
  //        [[migrations]]
  //        tag = "v1"
  //        new_classes = ["GatewayOpLock"]
  //      Source file: functions/api/gateway/gateway-op-lock.do.js (export GatewayOpLock).
  //      Deploy: `wrangler deploy` from the Worker directory.
  //   2. CF Dashboard -> Pages -> elligentt -> Settings -> Functions
  //      -> Durable Object bindings -> Add:
  //        Variable name: GATEWAY_OP_LOCK
  //        Namespace: (the namespace created in step 1)
  //   3. CF Dashboard -> Pages -> elligentt -> Settings -> Environment variables
  //      -> Production -> Add:
  //        DO_INTERNAL_SECRET  = <openssl rand -hex 32>   (random 32-byte secret)
  //        GATEWAY_RPC_URLS    = {"42161":"https://...","5042":"https://...","8453":"https://...","1":"https://...","10":"https://...","137":"https://..."}
  //        GATEWAY_ENV         = production
  //   4. Re-deploy the Pages project.
  //
  // GATEWAY_EXECUTION_COORDINATOR — cross-salt Gateway financial coordinator
  //   (Phase 1.0.1C.1, isolated development — NOT active in production).
  //   One Durable Object per (depositor, environment) adds a cross-salt dedup gate
  //   (on a caller-provided idempotency key) and a quantitative balance reservation
  //   (per source token+domain scope) on top of the per-salt GATEWAY_OP_LOCK. It is
  //   INACTIVE in transfer.js unless BOTH this binding is present AND
  //   env.GATEWAY_EXECUTION_COORDINATOR_ENABLED === 'true'. When the flag is ON but
  //   the binding is absent/invalid/unavailable, transfers fail closed (503) BEFORE
  //   any submission — never a silent fallback to the legacy per-salt-only flow.
  //   Requires each request item to carry a stable idempotencyKey, and requires an
  //   authoritative balance snapshot per scope (server-side fetch + /set-balance).
  //   Activation steps (same pattern as GATEWAY_OP_LOCK):
  //     1. Create a separate CF Worker whose wrangler.toml declares:
  //          [[durable_objects.bindings]]
  //          name = "GATEWAY_EXECUTION_COORDINATOR"
  //          class_name = "GatewayExecutionCoordinator"
  //          [[migrations]]
  //          tag = "v1"
  //          new_classes = ["GatewayExecutionCoordinator"]
  //        Source: functions/api/gateway/gateway-execution-coordinator.do.js
  //        (export GatewayExecutionCoordinator). Deploy with `wrangler deploy`.
  //     2. CF Dashboard → Pages → elligentt → Settings → Functions → DO bindings:
  //          Variable name: GATEWAY_EXECUTION_COORDINATOR
  //          Namespace:     (namespace from step 1)
  //     3. Set DO_INTERNAL_SECRET (already required by GATEWAY_OP_LOCK).
  //     4. Re-deploy the Pages project, then set
  //        GATEWAY_EXECUTION_COORDINATOR_ENABLED = 'true' (controlled roll-out).
  //   Rollback (drain): set GATEWAY_EXECUTION_COORDINATOR_ENABLED = 'false' (or
  //   remove the binding). Pending operations in the coordinator remain readable via
  //   /status for reconciliation; the per-salt GATEWAY_OP_LOCK records are untouched.
  //   Disabling the flag does NOT release ambiguous reservations and does NOT permit
  //   resubmission of operations already started.
  //
  //   MODES (Phase 1.0.1D.1): 'disabled' | 'pilot' | 'enabled' | 'draining'.
  //     - disabled: legacy flow (default).
  //     - pilot:    coordinated execution ONLY for allowlisted wallets.
  //     - enabled:  reserved for future approval (not activated this phase).
  //     - draining: suspend new coordinated operations; reconcile existing.
  //   PILOT CONFIG (env vars, all server-validated + atomic):
  //     GATEWAY_PILOT_ALLOWLIST       = comma-separated 0x wallet addresses
  //     GATEWAY_PILOT_MAX_PER_OP      = '1000000'  (1 USDC, atomic units)
  //     GATEWAY_PILOT_MAX_PER_DAY     = '10000000' (10 USDC, atomic units)
  //     GATEWAY_PILOT_MAX_CONCURRENT  = '1'         (max concurrent ops per wallet)
  //     GATEWAY_PILOT_KILL_SWITCH     = 'true'      (immediate stop of new ops)
  //   Unauthorized wallets in pilot mode fall through to the legacy flow unchanged.
  //
  // PAYMENT_LOCK — atomic per-(chainId+txHash) idempotence lock for payment links.
  //   Same activation process, using PaymentLock class from functions/api/payment-lock.do.js.
  //   Until activated, payment/[token].js falls back to KV-sentinel strategy.
  //
  // X402_INTENT_LOCK — durable x402 payment-intent store (Phase X402-2.1B).
  //   One Durable Object per authenticated userId; stores payment intents,
  //   idempotency-key bindings and EIP-3009 authorization-nonce reservations.
  //   Same activation process as GATEWAY_OP_LOCK, using the X402IntentStore class
  //   from functions/api/x402/x402-intent.do.js (export X402IntentStore).
  //   SQLite-backed (new namespace migration tag "v1"). Requires DO_INTERNAL_SECRET.
  //   Until bound (or while X402_INTENT_PERSISTENCE=false), /api/x402/intent*
  //   routes fail closed with HTTP 503.

  "vars": {
    "AUTH_MODE": "strict",
    "RATE_LIMIT_MODE": "enforce",
    "CIRCUIT_BREAKER": "on",
    "OBSERVABILITY": "on",
    "AUDIT": "on",
    "CORE_ALLOWED_ORIGINS": "https://execdaat.xyz,https://elligentt.xyz,https://elligente.pages.dev,https://elligentttest.pages.dev"
  }
}
