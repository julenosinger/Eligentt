# ══════════════════════════════════════════════════════════
#  Elligentt — Wrangler local dev vars template (Cloudflare Pages)
#  Copy to .dev.vars (git-ignored) and fill in real values.
#  NEVER commit .dev.vars or any file with real secrets.
#
#  Production secrets are set with:
#    npx wrangler pages secret put <NAME>
# ══════════════════════════════════════════════════════════

# ── Network (Arc Mainnet) ─────────────────────────────────
# Optional override; defaults are already Arc Mainnet in code.
#   chain 5042 · RPC https://rpc.mainnet.arc.io · explorer https://explorer.arc.io
ARC_RPC_URL=
ARC_RPC_FALLBACK=

# ── LI.FI (router / cross-chain) ──────────────────────────
# Get from https://portal.li.fi/  (secret)
LIFI_API_KEY=
# Integrator slug (max 23 chars) — analytics, not a secret
LIFI_INTEGRATOR=elligentt

# ── Circle / App Kit (legacy injectable keys) ─────────────
# Injected into HTML placeholders by the Pages Function (secrets).
TEST_API_KEY=
KIT_KEY=

# ── Circle Programmable Wallets (Autonoma / AI Smart Wallet agent-signer) ──
# Developer-controlled wallet used to sign agent transactions server-side.
# Credentials are secrets — NEVER expose to the browser.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
# Canonical Circle-controlled wallet for the agent. This is the ONLY wallet the
# Autonoma/AI Smart Wallet agent may sign with. Do not substitute another address.
CIRCLE_WALLET_ADDRESS=0x794eb2f43a333e9eab9731d8f5e5423d5ec628eb

# ── Agent-signer authorization proof ──────────────────────
# HMAC secret for single-use execution proofs (min 16 chars). Secret.
AGENT_SIGNER_PROOF_SECRET=
# Set "true" to pause the Circle agent-signer (kill switch, optional).
AGENT_SIGNER_PAUSED=false

# ── Auth / Relayer ────────────────────────────────────────
# Master secret for custodial wallet encryption (per-user salt). Secret.
AUTH_SECRET=
# Operator EOA private key for /api/relayer + /api/relayer/mint. Secret.
TURBO_RELAYER_PRIVATE_KEY=
# Comma-separated allowlist of authorized signer addresses (REQUIRED in production).
RELAYER_ALLOWED_USERS=
RELAYER_EIP712_ENABLED=false
RELAYER_REQUIRE_SELF=true
RELAYER_KILL_SWITCH=false

# ── Treasury Core (multi-app) ─────────────────────────────
# Shared secret for ExecDaat / Core HMAC service auth. Secret.
EXECDAAT_APP_SECRET=

# ── WalletConnect / Google OAuth ──────────────────────────
WC_PROJECT_ID=
GOOGLE_CLIENT_ID=

# ── AI Models (optional server proxies) ───────────────────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowed origins for /api/* routes (public, not secret).
ALLOWED_ORIGINS=https://elligentt.xyz,https://elligente.pages.dev,https://execdaat.xyz
APP_ORIGINS=https://elligentt.xyz,https://elligente.pages.dev,https://execdaat.xyz
# "true" during local dev to allow localhost origins.
ALLOW_LOCALHOST=false

# ── Runtime ───────────────────────────────────────────────
NODE_ENV=production
