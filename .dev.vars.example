# ══════════════════════════════════════════════════════════
#  Elligentt — Wrangler local dev vars template (Cloudflare Pages)
#  Copy to .dev.vars (git-ignored) and fill in real values.
#  NEVER commit .dev.vars or any file with real secrets.
#
#  Production secrets are set with:
#    npx wrangler pages secret put <NAME>
# ══════════════════════════════════════════════════════════

# ── Network (Arc Mainnet) ─────────────────────────────────
# Optional override; defaults are already Arc Mainnet in code.
#   chain 5042 · RPC https://rpc.mainnet.arc.io · explorer https://explorer.arc.io
ARC_RPC_URL=
ARC_RPC_FALLBACK=

# ── LI.FI (router / cross-chain) ──────────────────────────
# Get from https://portal.li.fi/  (secret)
LIFI_API_KEY=
# Integrator slug (max 23 chars) — analytics, not a secret
LIFI_INTEGRATOR=elligentt

# ── Circle / App Kit (legacy injectable keys) ─────────────
# Injected into HTML placeholders by the Pages Function (secrets).
TEST_API_KEY=
KIT_KEY=

# ── Circle Programmable Wallets (Autonoma / AI Smart Wallet agent-signer) ──
# Developer-controlled wallet used to sign agent transactions server-side.
# Credentials are secrets — NEVER expose to the browser.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
# Canonical Circle-controlled wallet for the agent. This is the ONLY wallet the
# Autonoma/AI Smart Wallet agent may sign with. Do not substitute another address.
CIRCLE_WALLET_ADDRESS=0x794eb2f43a333e9eab9731d8f5e5423d5ec628eb

# ── Agent-signer authorization proof ──────────────────────
# HMAC secret for single-use execution proofs (min 16 chars). Secret.
AGENT_SIGNER_PROOF_SECRET=
# Set "true" to pause the Circle agent-signer (kill switch, optional).
AGENT_SIGNER_PAUSED=false

# ── Auth / Relayer ────────────────────────────────────────
# Master secret for custodial wallet encryption (per-user salt). Secret.
AUTH_SECRET=
# Operator EOA private key for /api/relayer + /api/relayer/mint. Secret.
TURBO_RELAYER_PRIVATE_KEY=
# Comma-separated allowlist of authorized signer addresses (REQUIRED in production).
RELAYER_ALLOWED_USERS=
RELAYER_EIP712_ENABLED=false
RELAYER_REQUIRE_SELF=true
RELAYER_KILL_SWITCH=false

# ── Treasury Core (multi-app) ─────────────────────────────
# Shared secret for ExecDaat / Core HMAC service auth. Secret.
EXECDAAT_APP_SECRET=

# ── WalletConnect / Google OAuth ──────────────────────────
WC_PROJECT_ID=
GOOGLE_CLIENT_ID=

# ── AI Models (optional server proxies) ───────────────────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Circle Payments Network (CPN) — Fiat Payouts ─────────────
# OFI API key from Circle (requires OFI onboarding at developers.circle.com/cpn).
# Without this key, /api/cpn/* returns 503 with a clear message.
# There is no mock mode — all calls hit the real Circle CPN API.
CPN_API_KEY=

# CPN_LOCK — Durable Object binding for ATOMIC payment idempotency (REQUIRED).
# The CpnLock class (functions/api/cpn-lock.do.js) must be deployed as a separate
# Worker and bound to this Pages project via the dashboard (like PAYMENT_LOCK).
# Without this binding, POST /api/cpn/payments FAILS SAFE (503 CPN_LOCK_NOT_CONFIGURED)
# rather than silently falling back to a non-atomic KV reservation.
#   Variable name: CPN_LOCK
#   Durable Object namespace: the namespace exported by the CpnLock Worker
# Optional dev-only escape hatch: set "true" to use the NON-ATOMIC KV reservation
# (responses carry `degraded: true`). NOT recommended for production — Circle's
# Idempotency-Key remains the authoritative dedup, but local serialization is lost.
# CPN_ALLOW_KV_FALLBACK=false

# ── x402 Payments (Autonoma, Phase 1 — infrastructure only) ──
# Master switch. Keep "false" until network + EIP-3009 settlement compatibility
# is confirmed (see docs/x402-integration.md). Real payments are NOT wired yet.
X402_ENABLED=false
# Maximum USD per single x402 payment (default 25).
X402_MAX_USD=25
# Optional allowlist of hosts the x402 discovery proxy may fetch (SSRF guard).
# Comma-separated. Empty = any public http(s) host (dev only).
X402_ALLOWED_HOSTS=

# ── x402 Payment Intent persistence (Phase X402-2.1B — durable intents) ──
# Master switch for the durable payment-intent API (/api/x402/intent*).
# Keep "false" until the X402_INTENT_LOCK Durable Object binding is provisioned.
# Real payment execution remains disabled regardless of this flag.
X402_INTENT_PERSISTENCE=false
# Intent expiration TTL in seconds (server policy, distinct from the requirement
# timeout). Default 3600 (1h). Bounds: 1..86400.
X402_INTENT_TTL_SECONDS=3600
# Maximum intents retained per user (record-count limit). Default 200.
X402_INTENT_MAX_PER_USER=200

# ── x402 EIP-712 signing (Phase X402-2.1C — authorization only, no settlement) ──
# Master switch for Circle Wallet EIP-3009 TransferWithAuthorization signing.
# Keep "false" unless explicitly authorized. Signing does NOT broadcast or settle.
# Requires CIRCLE_API_KEY + CIRCLE_ENTITY_SECRET (above).
X402_SIGNING_ENABLED=false
# Maximum permitted payment lifetime (seconds) for a signed authorization window.
# Default 3600 (1h). Bounds: 1..86400.
X402_AUTH_WINDOW_SECONDS=3600

# ── x402 Facilitator Service (Phase X402-2.1D.1 — verify only, no settlement) ──
# Enable facilitator VERIFY (read-only, non-settling) calls. Requires CIRCLE_API_KEY.
# Settlement is NEVER enabled in this phase (the /settle transport is disabled).
X402_FACILITATOR_VERIFY=false
# Optional override for the facilitator base URL (default https://api.circle.com).
# FACILITATOR_BASE_URL=https://api.circle.com

# ── X402_INTENT_LOCK — Durable Object binding for durable x402 intents ──
# The X402IntentStore class (functions/api/x402/x402-intent.do.js) must be
# deployed as a separate Worker and bound to this Pages project via the
# dashboard (like CPN_LOCK / GATEWAY_OP_LOCK). Uses DO_INTERNAL_SECRET for
# internal auth. Without this binding, /api/x402/intent* fails safe (503).
#   Variable name: X402_INTENT_LOCK
#   Durable Object namespace: the namespace exported by the X402IntentStore Worker


# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowed origins for /api/* routes (public, not secret).
ALLOWED_ORIGINS=https://elligentt.xyz,https://elligente.pages.dev,https://execdaat.xyz
APP_ORIGINS=https://elligentt.xyz,https://elligente.pages.dev,https://execdaat.xyz
# "true" during local dev to allow localhost origins.
ALLOW_LOCALHOST=false

# ── Runtime ───────────────────────────────────────────────
NODE_ENV=production
